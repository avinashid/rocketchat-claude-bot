# --- Rocket.Chat connection (required) --------------------------------------

RC_URL=https://rocket.chillidevs.com

# Personal Access Token from an admin account:
#   Avatar -> My Account -> Personal Access Tokens -> Add
#   tick "Ignore Two Factor Authentication", then copy BOTH values.
RC_AUTH_TOKEN=
RC_USER_ID=

# --- Access control (required, fails closed) --------------------------------

# Rocket.Chat usernames allowed to drive Claude Code. Empty = the bot answers
# NOBODY, on purpose: answering someone gives them Claude Code on this machine.
BOT_ALLOWED_USERNAMES=

# Usernames that may run `!admin` to unlock full host access in a room.
# Empty = `!admin` is disabled for everyone.
BOT_ADMIN_USERNAMES=

# Rooms the bot listens in: channel names or room ids, comma-separated.
# `*` = every room the bot account is a member of. DMs always work.
BOT_ALLOWED_ROOMS=

# --- Behaviour --------------------------------------------------------------

# true: read every message in allowed rooms and let the triage model decide
#       whether a reply is wanted (what you asked for).
# false: only ever answer direct @mentions and DMs.
BOT_LISTEN_ALWAYS=true

# Small fast model for the "is this for me?" gate. Runs on every unaddressed
# message, so it should stay cheap.
BOT_TRIAGE_MODEL=claude-haiku-4-5-20251001

# Model for real answers. Empty = Claude Code's default.
BOT_MODEL=

# How many recent messages of channel context to keep per room.
BOT_CONTEXT_MESSAGES=12

# --- Sandbox ----------------------------------------------------------------

# Where Claude Code runs. Keep it dedicated, not your home directory.
BOT_WORKSPACE=/home/ubuntu/projects/rocketchat-claude-workspace

# Extra directories a normal run may read/write, comma-separated.
BOT_ADD_DIRS=

# acceptEdits | plan | dontAsk | bypassPermissions
BOT_PERMISSION_MODE=acceptEdits

# Tools a normal run may use unattended. In print mode nothing can answer a
# permission prompt, so anything not listed here is refused.
BOT_ALLOWED_TOOLS=mcp__rocketchat,Bash,Read,Write,Edit,Glob,Grep,WebFetch,WebSearch,TodoWrite,NotebookEdit,Task

# The `!admin` profile.
BOT_ADMIN_PERMISSION_MODE=bypassPermissions
BOT_ADMIN_CWD=/home/ubuntu
BOT_ADMIN_ADD_DIRS=/home/ubuntu

# --- Limits -----------------------------------------------------------------

BOT_TIMEOUT_SECONDS=600
BOT_ADMIN_TIMEOUT_SECONDS=900
BOT_MAX_MESSAGE_CHARS=3500
BOT_EDIT_INTERVAL_MS=2000
BOT_SHOW_COST=false
BOT_CLAUDE_BIN=claude
